# Copy to `config/.env` — this directory holds env files and nothing else, so it is also
# the safe place to mount a secret over in a container (`-v ./secrets:/app/config`).
# Set ENV_FILE to read from somewhere else entirely.
#
# Leave both unset to run against the built-in mock LMS (the default).
# Set BOTH to talk to a real cbr-api2 instance.
#
# The LMS side needs, once:
#   1. a technical role holding only pages.can_send_external_resource_data
#   2. a technical user with that role
#   3. an API token issued for that user
#   4. a URL-type resource with "Receive data from an external resource" enabled
#
# LMS_BASE_URL=https://your-site.example.com
# LMS_API_TOKEN=

PORT=3000

# Double-quoted on purpose. `process.loadEnvFile` strips one layer of quoting, and CSP needs
# the inner `'self'` to keep its own — bare `frame-ancestors self` is read as a *host* named
# "self", which matches nothing and blocks every embed. Worse, single quotes here truncate
# the value at the closing quote: ALLOWED_FRAME_ANCESTORS='self' https://lms.example.com
# arrives as just `self`, silently dropping the LMS that needs to be listed.
#
# Add each origin allowed to iframe this app. 'self' alone covers the built-in mock host
# page only; a real LMS is a different origin and must be named here:
#   ALLOWED_FRAME_ANCESTORS="'self' https://your-site.example.com"
ALLOWED_FRAME_ANCESTORS="'self'"
